# --- Anthropic (classification + Ask the Cabinet) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-5
# CLAUDE_MODEL=claude-sonnet-5

# --- Supabase (existing project) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Settings → API → service_role (server-only!)

# --- Google OAuth (login + Drive drive.file scope) ---
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- Auth.js ---
AUTH_SECRET=  # npx auth secret, or: openssl rand -base64 32
# AUTH_URL is auto-detected on Vercel; set for local dev if needed:
# AUTH_URL=http://localhost:3000

# --- Access control ---
ALLOWED_LOGIN_EMAIL=you@example.com
# Comma-separated senders whose email forwards are accepted:
ALLOWED_SENDERS=you@example.com

# --- Postmark inbound webhook ---
# Random secret; webhook URL is /api/inbound-email?token=<this>
POSTMARK_WEBHOOK_TOKEN=

# --- Drive ---
DRIVE_ROOT_FOLDER_NAME=House Docs
